# ==============================================================================
# ATM System Configuration Template
# ==============================================================================

# Credenciales de Base de Datos PostgreSQL
DB_USER=admin
DB_PASSWORD=password

# Clave criptográfica compartida para firma y validación de tokens JWT
JWT_SECRET=secreto_del_pinguino_aislado

# Endpoint del servicio centralizado de auditoría de logs
# En entorno Docker Compose utilizar: http://logs_service:5000/logs
# En entorno local/host utilizar: http://localhost:5000/logs
LOGS_URL=http://logs_service:5000/logs

# Tokens estáticos de autorización entre servicios para logs_service
TOKEN_AUTH=TOKEN-AUTH-002
TOKEN_ACCOUNT=TOKEN-PAYMENTS-003
TOKEN_ADMIN=TOKEN-ADMIN-005

# Puertos expuestos en el Host
LOGS_PORT=5000
AUTH_PORT=5001
ACCOUNT_PORT=5002